{
  "manifest_version": 3,
  "name": "Memo-Nexus Web Clipper",
  "version": "0.2.0",
  "description": "記事本文と選択範囲を画像候補付きでMemo-Nexusの確認画面へ渡します。",
  "action": {
    "default_title": "Memo-Nexus Web Clipper",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "tabs", "storage", "unlimitedStorage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:5500/*",
    "https://tetsujisugimori-coder.github.io/memo/*"
  ],
  "content_scripts": [{
    "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://tetsujisugimori-coder.github.io/memo/*"],
    "js": ["transfer-content.js"],
    "run_at": "document_start"
  }]
}
